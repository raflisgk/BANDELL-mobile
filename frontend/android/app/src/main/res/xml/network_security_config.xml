<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Default: Larang cleartext HTTP traffic untuk seluruh domain publik -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Khusus IP development lokal: izinkan HTTP untuk pengujian di laptop/Wi-Fi -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">192.168.1.18</domain>
        <domain includeSubdomains="true">192.168.1.110</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
    </domain-config>
</network-security-config>

